# .env.local
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git (it's already in .gitignore)

# ─── Supabase ──────────────────────────────────────────────
# Get these from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...YOUR_ANON_KEY

# ─── Paystack ──────────────────────────────────────────────
# Get these from: dashboard.paystack.com → Settings → API Keys
# Use TEST keys during development, LIVE keys for production
PAYSTACK_SECRET_KEY=sk_test_YOUR_SECRET_KEY
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY

# ─── Anthropic (for AI Study Assistant) ────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY

# ─── App URL ────────────────────────────────────────────────
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (update this when you deploy to Vercel)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
